# Database and queues
DATABASE_URL=postgresql://ielts:ielts@localhost:5432/ielts
REDIS_URL=redis://localhost:6379

# Private PDF/document storage. Local development can use MinIO; production can use any S3-compatible bucket such as Cloudflare R2.
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=ielts-private
S3_ACCESS_KEY=ielts
S3_SECRET_KEY=change-me-locally

# Authentication
BETTER_AUTH_SECRET=change-me-with-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000

# Reserved scoring service endpoint. The production scoring workflow is still server-side only.
AI_SERVICE_URL=http://localhost:8000

# Public display copy only. Never place secrets or scoring prompts in NEXT_PUBLIC_*.
NEXT_PUBLIC_PRODUCT_NAME=雅思提分系统
